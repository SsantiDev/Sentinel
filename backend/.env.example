# Django
SECRET_KEY=cambia-esto-por-algo-largo-y-aleatorio
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Settings a usar en local (evita el redirect a HTTPS de produccion).
# En docker-compose.yml ya se fuerza este valor; se deja aqui por si corres sin Docker.
DJANGO_SETTINGS_MODULE=config.settings.local

# Superusuario creado automaticamente al levantar Docker (cambialo si quieres).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@sentinel.local
DJANGO_SUPERUSER_PASSWORD=admin12345

# Database
DATABASE_URL=postgres://sentinel:password@db:5432/sentinel_db

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Alerts
ALERT_EMAIL_FROM=alerts@sentinel.local
ALERT_EMAIL_RECIPIENTS=you@example.com,oncall@example.com
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional: Slack
SLACK_WEBHOOK_URL=
